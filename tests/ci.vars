# What cocon/compose.yml interpolates, for CI (cocon.yml loads this file into every step's env) and for
# tests/test_compose.py. A new variable compose requires goes here, never in the workflow. CI builds and
# pulls but never starts a service, so paths are placeholders.
REPO_VOLUMES=cocon-ci
LOG_DIR=/tmp/cocon-ci
LOG_NAME=ci.log
