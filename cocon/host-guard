#!/usr/bin/env bash
# host-guard: spot what a session changed that the host runs later. Usage and code: cocon/py/kit/guard/cli.py
# (ADR 0013); this shim only finds python3.
kit="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)" || exit 2
command -v python3 >/dev/null || { echo "host-guard: needs python3; run: xcode-select --install" >&2; exit 2; }
exec python3 -I -B "$kit/py" host-guard "$@"
