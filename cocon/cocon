#!/usr/bin/env bash
# cocon: run Claude Code for one repo inside an isolated container. `cocon --help` for usage;
# the code is cocon/py/kit/launcher/ (ADR 0013): this shim only finds python3.
kit="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)" || exit 1
command -v python3 >/dev/null || { echo "cocon: needs python3; run: xcode-select --install" >&2; exit 1; }
exec python3 -I -B "$kit/py" cocon "$@"
